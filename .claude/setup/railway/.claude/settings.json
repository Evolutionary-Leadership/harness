{
  "env": {
    "API_TIMEOUT_MS": "600000",
    "CLAUDE_CODE_MAX_RETRIES": "5"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/hooks/prevent-em-dash.sh"
          },
          {
            "type": "command",
            "command": "./.claude/hooks/protect-frozen-docs.sh"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/hooks/prevent-em-dash.sh"
          },
          {
            "type": "command",
            "command": "./.claude/hooks/protect-frozen-docs.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/hooks/prevent-em-dash.sh"
          }
        ]
      },
      {
        "matcher": "mcp__github__(create_or_update_file|push_files|issue_write|add_issue_comment|update_issue_comment|create_pull_request|update_pull_request)",
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/hooks/prevent-em-dash.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/scripts/session-start.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push)",
            "command": "./.claude/hooks/post-push-railway-url.sh"
          }
        ]
      }
    ]
  }
}
