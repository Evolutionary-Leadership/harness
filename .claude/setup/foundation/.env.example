# Every environment variable this app reads, in one place.
#
# All of them are parsed by the single Zod schema in src/lib/env.ts. Copy this
# file to .env.local for local development; .env* is gitignored and must never
# be committed.
#
# The per-environment matrix (what production, preprod, and feature environments
# each set) lives in docs/architecture/configuration.md, and the two minute
# Railway walkthrough is docs/runbooks/railway-setup.md.

# =============================================================================
# REQUIRED. The app cannot boot without these two, and nothing else is required:
# a variable that is required but unused turns every environment lacking it into
# a crash loop.
# =============================================================================

# Postgres connection string.
# Set on: every environment.
# On Railway: wire it as the reference variable ${{Postgres.DATABASE_URL}}, never
# a literal. A reference re-resolves per environment, so it clones safely into
# each feature environment and points at that environment's own database.
DATABASE_URL=postgresql://notes:notes@127.0.0.1:5432/notes

# Signing key for session cookies. Minimum 32 characters, unique per environment.
# Set on: every environment.
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-at-least-32-characters-of-random

# =============================================================================
# OPTIONAL. Each is checked at its point of use, never at boot.
# =============================================================================

# The app's public origin, used for auth callbacks and trusted origins.
# Set on: PRODUCTION ONLY, and only when the origin is a custom domain.
# Leave it UNSET on preprod and feature environments: the code then falls back to
# https://$RAILWAY_PUBLIC_DOMAIN, which is how an ephemeral environment
# configures itself with no manual step. Setting a literal here on preprod would
# clone that literal into every feature environment and break their sign in.
# BETTER_AUTH_URL=https://notes.example.com

# React and Next runtime switch, NOT an environment label.
# Set on: every DEPLOYED environment, as production. That includes preprod and
# feature environments. `development` is only correct locally under next dev.
# Nothing may use this to answer "is this production"; see ADR 0003.
NODE_ENV=development

# Run scripts/seed.ts on deploy. Seeds only when the value is exactly "true".
# Set on: preprod = true (set it explicitly; the harness leaves preprod unset, and unset
# means no seeding). Feature environments inherit true from preprod, which is what
# you want: a fresh preview arrives with data and a working demo login.
# Production = false.
SEED_DATA=true

# Signup is open unless this is exactly "false". Enforced server side by Better
# Auth's disableSignUp, not just hidden in the UI.
# Set on: production, if you want a closed signup. Leave unset elsewhere.
# ALLOW_SIGNUP=false

# Render the one click demo login button. Only when exactly "true".
# Set on: preprod = true (inherited by feature environments). NEVER on production.
# The login page is a Server Component, so with this unset the demo credentials
# never enter the client bundle at all.
SHOW_DEMO_LOGIN=true

# Overrides for the seeded demo account. Both have hardcoded fallbacks pointing
# at a clearly fictional user, so neither has to be set anywhere.
# The seed creates this account whenever it runs, independent of SHOW_DEMO_LOGIN.
# DEMO_LOGIN_EMAIL=ada.demo@example.invalid
# DEMO_LOGIN_PASSWORD=demo-notes-please-change

# pino log level: fatal, error, warn, info, debug, trace, silent. Defaults to info.
# LOG_LEVEL=info

# =============================================================================
# TESTS ONLY. Not read by the app.
# =============================================================================

# Escape hatch for the integration tier: point it at any reachable Postgres 16
# and Testcontainers is skipped entirely, which is what makes those tests
# runnable on a machine with no Docker daemon. Never point this at a database
# holding real data: the harness TRUNCATEs every table between tests.
TEST_DATABASE_URL=postgresql://notes:notes@127.0.0.1:5432/notes_test

# Port the e2e tier builds and boots the app on. Defaults to 3210, deliberately
# not 3000, so a Playwright run does not collide with a `pnpm dev` server you
# left running. playwright.config.ts derives the base URL and the webServer PORT
# from it, so overriding it here moves both together.
# E2E_PORT=3210

# Escape hatch for the e2e tier: an absolute path to a Chromium binary, for
# images that ship browsers whose build number does not match the pinned
# @playwright/test. Unset locally, where `pnpm exec playwright install` is the
# normal path.
# PLAYWRIGHT_CHROMIUM_PATH=/opt/pw-browsers/chromium

# =============================================================================
# INJECTED BY RAILWAY. Documented so you recognise them; never set them by hand.
# =============================================================================
#
#   PORT                      the port the app must listen on
#   RAILWAY_PUBLIC_DOMAIN     this environment's public hostname, no scheme
#   RAILWAY_ENVIRONMENT_NAME  "production", "preprod", or the feature env's name.
#                             The seed's production guard reads this.
#
# This project uploads no files, so the AWS_* object storage variables Railway's
# bucket plugin provides are UNUSED. Nothing reads them, and src/lib/env.ts does
# not declare them. Add them here if and when a feature needs uploads.
