{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "watchPatterns": [
      "src/**",
      "drizzle/**",
      "scripts/**",
      "package.json",
      "pnpm-lock.yaml",
      "next.config.ts",
      "drizzle.config.ts",
      "tsconfig.json",
      "postcss.config.mjs"
    ]
  },
  "deploy": {
    "startCommand": "npm run db:migrate && if [ \"$SEED_DATA\" = \"true\" ]; then npm run seed; fi && npm run start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
