{
  "_about": "Every file the harness ships, at its final repo-relative path, with the class /harness-upgrade gives it and the variant that receives it (both, or railway). Managed files are replaced on upgrade: do not edit them. Files the harness never ships (your CLAUDE.md, your application code, skills you added) are project-owned and absent here. Generated from the shipped tree by the forge's scripts/gen-harness-manifest.mjs; the prose home of the classes is .claude/HARNESS.md.",
  "classes": {
    "_about": "The five path classes /harness-upgrade applies, in precedence order: the first rule whose paths match a file decides it. Source of truth: .claude/scripts/harness-upgrade-plan.mjs (classify). Prose: .claude/HARNESS.md, 'How an upgrade decides what to change'.",
    "precedence": [
      "blocked",
      "stamp",
      "config",
      "starter",
      "managed"
    ],
    "blocked": {
      "outcome": "never written, in any class",
      "paths": [
        ".claude/setup/**",
        ".claude/skills/setup/**",
        ".claude/scripts/setup.sh",
        ".github/workflows/harness-preflight.yml",
        ".github/workflows/harness-railway.yml",
        ".harness-bootstrap",
        ".harness-preflight",
        "README.md"
      ]
    },
    "stamp": {
      "outcome": "version: line amended in place; every other field survives",
      "paths": [
        ".harness-version"
      ]
    },
    "config": {
      "outcome": "merged, never copied over: new keys added, values the project set are kept",
      "paths": [
        ".claude/settings.json",
        ".github/dependabot.yml",
        "railway.json",
        ".env.example"
      ]
    },
    "starter": {
      "outcome": "created only when missing, per file; never overwritten, never recreated once deleted",
      "paths": [
        "server.js",
        "package.json",
        ".gitignore",
        "LICENSE",
        "NOTICE",
        "docs/**",
        "scripts/**"
      ],
      "exceptions": [
        "scripts/check-spec.mjs",
        "scripts/gate-run.mjs",
        "scripts/judge-plan.mjs",
        "scripts/retrieval.mjs",
        "scripts/spec-test-claims.mjs",
        "scripts/strip-em-dash.sh"
      ]
    },
    "managed": {
      "outcome": "replaced with the target version's content",
      "paths": [
        "everything else the harness ships"
      ],
      "deletable_trees": [
        ".github/workflows/",
        ".claude/hooks/",
        ".claude/skills/",
        ".claude/scripts/",
        ".claude/agents/"
      ]
    }
  },
